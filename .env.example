# Copia este archivo como .env y llena los valores de tu app en Meta for Developers

# Puerto local del servidor
PORT=3000

# Texto secreto que tú inventas; se pone igual en Meta al configurar el webhook
WHATSAPP_VERIFY_TOKEN=cambia-esto-por-un-texto-largo-y-secreto

# App Dashboard > Configuración de la app > Básica > Clave secreta de la app
WHATSAPP_APP_SECRET=

# Token de acceso. Para pruebas, el temporal de WhatsApp > Configuración de la API.
# Para producción, un token permanente de un usuario del sistema (Business Manager).
WHATSAPP_TOKEN=

# WhatsApp > Configuración de la API > Identificador del número de teléfono
WHATSAPP_PHONE_NUMBER_ID=

# WhatsApp del asesor que recibe el aviso de nuevos interesados (con indicativo, ej. 573001234567).
# Con el número de prueba debe estar entre los destinatarios verificados y haber escrito
# al asistente en las últimas 24 horas.
ASESOR_WHATSAPP=

# Versión de la Graph API (revisa la vigente en developers.facebook.com)
GRAPH_API_VERSION=v25.0
